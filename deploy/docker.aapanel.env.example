# ==============================
# NhiCRM Docker env for aaPanel
# Copy to: deploy/docker.aapanel.env
# ==============================

# Ports published on host (Apache in aaPanel will proxy to these localhost ports)
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=3001
POSTGRES_HOST_PORT=5432

# Frontend build-time URL (same domain users open in browser)
NEXT_PUBLIC_API_URL=https://crm.congty.com

# Backend runtime
NODE_ENV=production
PORT=3000
JWT_SECRET=thay_bang_chuoi_dai_ngau_nhien

# Database (external DB OR local postgres profile)
DB_USER=crm_user
DB_HOST=127.0.0.1
DB_NAME=crm_core_system
DB_PASSWORD=your_strong_password
DB_PORT=5432
DB_SCHEMA=public

# Optional
REDIS_URL=
BASE_URL=https://crm.congty.com
PUBLIC_API_BASE_URL=https://crm.congty.com
FRONTEND_URL=https://crm.congty.com
