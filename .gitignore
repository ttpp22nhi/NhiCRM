# ===== Root .gitignore - TNiCRM =====

# Environment / secrets (all subprojects)
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build / output
.next/
out/
build/
dist/

# Testing
coverage/

# Logs & debug
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Uploaded files (backend storage)
storage/

# Misc
*.pem
.vercel
*.tsbuildinfo
next-env.d.ts

# IDE (optional - uncomment if needed)
# .idea/
# .vscode/
# *.swp
# *.swo
